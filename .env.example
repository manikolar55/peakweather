# Database (SQLite for local dev, PostgreSQL for production)
# For SQLite:     DATABASE_PROVIDER="sqlite"     DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_PROVIDER="postgresql" DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Anthropic API key — get one at console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# MET Norway Locationforecast 2.0
# Required: identify your application as per MET Norway terms of service
# Format: "AppName/Version contact@example.com"
METNO_USER_AGENT="PeakWeather/1.0 contact@example.com"

# OpenWeatherMap One Call 3.0 + Air Pollution API
# Optional: if omitted, the AQI section is hidden and rule-based alerts are used
# Free tier: 1000 calls/day; we cap at 950 to stay safe
OPENWEATHER_API_KEY=""

# Google AdSense publisher ID — leave blank to render placeholder ad slots
NEXT_PUBLIC_ADSENSE_ID=""

# Your deployed site URL (used for sitemap, OG images, canonical tags)
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
